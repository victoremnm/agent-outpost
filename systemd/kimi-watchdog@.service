[Unit]
Description=Kimi Code CLI tmux watchdog
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=%i
Environment=AGENT_NAME=kimi
Environment=AGENT_TMUX_SESSION=kimi-main
Environment=AGENT_WORKDIR=/home/%i/homelab
ExecStart=/bin/bash /home/%i/homelab/scripts/agent-watchdog.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
